{
  "name": "dsplat/multi-tenant-saas-module-gitlab",
  "description": "GitLab 集成",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "dsplat/multi-tenant-saas": "^1.0 || ^2.0 || ^3.0",
    "dsplat/multi-tenant-saas-base": "^3.6",
    "dsplat/multi-tenant-saas-module-archive": "^3.6"
  },
  "autoload": {
    "psr-4": {
      "MultiTenantSaas\\Modules\\Gitlab\\": ""
    }
  },
  "extra": {
    "saas": {
      "name": "gitlab",
      "priority": 300,
      "dependencies": [
        "integration"
      ],
      "conflicts": [],
      "requires_core": ">=3.1.0 <4.0.0",
      "provider": "MultiTenantSaas\\Modules\\Gitlab\\GitlabServiceProvider",
      "tenant_toggleable": true,
      "module_loadable": true,
      "default_tenant_enabled": false
    }
  }
}
